generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  REVIEWER
  WORKER
  OPERATOR
}

enum TaskStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  PAID
}

enum ReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model Operator {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  owners     Owner[]
  reviewers  Reviewer[]
  workers    Worker[]
  tasks      Task[]
  reviews    TaskReview[]
}

model Owner {
  id         String   @id @default(uuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  email      String   @unique
  password   String
  createdAt  DateTime @default(now())
}

model Reviewer {
  id         String   @id @default(uuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  email      String   @unique
  password   String
  createdAt  DateTime @default(now())

  reviews    TaskReview[]
}

model Worker {
  id         String   @id @default(uuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  email      String   @unique
  password   String
  createdAt  DateTime @default(now())

  tasks      Task[]
}

model Task {
  id            String      @id @default(uuid())
  operatorId    String
  operator      Operator    @relation(fields: [operatorId], references: [id])

  title         String
  description   String
  payoutAmount  Float

  workerId      String?
  worker        Worker?     @relation(fields: [workerId], references: [id])

  status        TaskStatus  @default(UNASSIGNED)
  completedAt   DateTime?

  // REVIEW RELATION — Task does NOT define fields/references
  review        TaskReview? @relation("TaskToReview")

  createdAt     DateTime    @default(now())
}

model TaskReview {
  id         String        @id @default(uuid())
  operatorId String
  operator   Operator      @relation(fields: [operatorId], references: [id])

  reviewerId String
  reviewer   Reviewer      @relation(fields: [reviewerId], references: [id])

  // TaskReview OWNS the foreign key
  taskId     String   @unique
  task       Task     @relation("TaskToReview", fields: [taskId], references: [id])

  status     ReviewStatus
  reason     String?

  createdAt  DateTime      @default(now())
}
